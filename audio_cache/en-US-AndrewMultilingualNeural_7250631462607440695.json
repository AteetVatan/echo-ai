{
    "text": "\u092e\u0947\u0930\u093e \u092a\u0947\u0936\u0947\u0935\u0930 \u0932\u0915\u094d\u0937\u094d\u092f \u090f\u0915 \u092a\u094d\u0930\u092e\u0941\u0916 AI \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930 \u0914\u0930 AI \u0911\u091f\u094b\u092e\u0947\u0936\u0928 \u0924\u0925\u093e LLM \u0907\u0902\u091f\u0940\u0917\u094d\u0930\u0947\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0930\u0923\u0928\u0940\u0924\u093f\u0915 \u0938\u0932\u093e\u0939\u0915\u093e\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u094b\u0928\u093e \u0939\u0948\u0964 \u092e\u0947\u0930\u093e \u0927\u094d\u092f\u093e\u0928 \u091c\u091f\u093f\u0932, \u090f\u091c\u0947\u0902\u091f-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u093f\u0938\u094d\u091f\u092e \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0939\u0948 \u091c\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e\u0913\u0902 \u0915\u094b \u092c\u0926\u0932 \u0938\u0915\u0947\u0902 \u2013 \u091c\u0948\u0938\u093e \u0915\u093f \u092e\u0948\u0902\u0928\u0947 ApplyBots \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0928\u094c\u0915\u0930\u0940 \u0916\u094b\u091c \u0914\u0930 MedAI \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0928\u093f\u0926\u093e\u0928 \u0938\u0939\u093e\u092f\u0924\u093e \u091c\u0948\u0938\u0940 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0930\u0942\u092a \u0938\u0947, \u092e\u0948\u0902 \u0924\u0915\u0928\u0940\u0915\u0940 \u0915\u093e\u0930\u094d\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0914\u0930 \u0930\u0923\u0928\u0940\u0924\u093f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f \u0915\u0947 \u092c\u0940\u091a \u092a\u0941\u0932 \u092c\u0928\u093e\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0942\u0902, \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0911\u091f\u094b\u092e\u094b\u091f\u093f\u0935 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930, \u0930\u0915\u094d\u0937\u093e-\u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0947\u0902\u0938 \u0914\u0930 \u0939\u0947\u0932\u094d\u0925\u0915\u0947\u092f\u0930-\u090f\u0906\u0908 \u091c\u0948\u0938\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902\u0964",
