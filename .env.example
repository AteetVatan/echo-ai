# ── Required API Keys ─────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-proj-your-openai-key
MISTRAL_API_KEY=your-mistral-key

# ── Model Configuration ──────────────────────────
FALLBACK_STT_MODEL=openai/whisper-1
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-small
OPENAI_MODEL=gpt-4o-mini

# ── LLM API Endpoints ────────────────────────────
DEEPSEEK_API_BASE=https://api.deepseek.com
MISTRAL_API_BASE=https://api.mistral.ai

# ── Edge-TTS Configuration ───────────────────────
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural

# ── Latency Configuration ────────────────────────
STT_CHUNK_DURATION=2.0
LLM_TEMPERATURE=0.0
TTS_STREAMING=True
TTS_CACHE_ENABLED=True

# ── Self-Info RAG Knowledge Base ─────────────────
SELF_INFO_JSON_PATH=src/documents/self_info.json
SELF_INFO_CHROMA_DIR=src/db/self_info_knowledge_v2
SELF_INFO_REBUILD=0
EVIDENCE_DOCS_DIR=rag_persona_db/document

# ── Database Configuration (Supabase, optional) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# ── Server Configuration ─────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=False

# ── Audio Configuration ──────────────────────────
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_FORMAT=wav

# ── Timeout Configuration (in seconds) ───────────
STT_TIMEOUT=5.0
LLM_TIMEOUT=10.0
TTS_TIMEOUT=8.0

# ── Security Configuration ───────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ECHOAI_API_KEY=your-generated-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
WS_MSG_RATE_LIMIT=20
MAX_WS_CONNECTIONS_PER_IP=5
MAX_TEXT_LENGTH=2000

# ── HuggingFace (optional) ───────────────────────
HF_TOKEN=
